{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dartsnut Agent",
  "version": "1.7.4",
  "identifier": "com.dartsnut.agent",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dartsnut Agent",
        "width": 1560,
        "height": 980,
        "minWidth": 1320,
        "minHeight": 860,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https://*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "${TAURI_SIGNING_PUBLIC_KEY}",
      "endpoints": [
        "https://dartsnutstore.oss-cn-hongkong.aliyuncs.com/agent-update/latest.json"
      ],
      "dangerousInsecureTransportProtocol": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Build and deploy Dartsnut games and widgets",
    "longDescription": "Dartsnut Agent desktop application",
    "resources": {
      "../../../services/emulator-core": "services/emulator-core",
      "../../../assets": "assets",
      "../../../packages/agent-runtime/skills": "packages/agent-runtime/skills",
      "../../../scripts/asset_preprocess.py": "scripts/asset_preprocess.py",
      "../../../PixelDarts.png": "PixelDarts.png",
      "../../../requirements.txt": "requirements.txt"
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": true}
    }
  }
}
